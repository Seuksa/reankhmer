---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import SpeakPractice from '../components/SpeakPractice.vue';
import { speakSets } from '../lib/content';
---

<BaseLayout title="និយាយ Speaking practice" description="Practise speaking Khmer: listen to a native speaker, record yourself and compare the voice shape and melody. Your voice stays on your device.">
  <h1 class="mb-3 text-2xl font-semibold"><T km="ហាត់និយាយ" en="Speaking practice" /></h1>
  <SpeakPractice client:load sets={speakSets()} />
</BaseLayout>
