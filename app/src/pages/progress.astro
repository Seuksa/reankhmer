---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import ProgressPanel from '../components/ProgressPanel.vue';
import { CHAPTER_TITLE, reviewItems, alphabetMedia, chapterMedia, chapters, consonants, khmerDigits, vowels } from '../lib/content';

const packs = [
  { id: 'alphabet', km: 'ព្យញ្ជនៈ ស្រៈ និងលេខ', en: 'Letters, vowels and numbers', urls: alphabetMedia() },
  ...chapters.filter((ch) => ch.number > 1).map((ch) => ({
    id: `ch${ch.number}`,
    km: `ជំពូក ${khmerDigits(ch.number)} · ${CHAPTER_TITLE[ch.number].km}`,
    en: `Chapter ${ch.number} · ${CHAPTER_TITLE[ch.number].en}`,
    urls: chapterMedia(ch),
  })),
];
const totals = {
  letters: consonants.length,
  vowels: vowels.reduce((n, v) => n + (v.audio_series1 ? 1 : 0) + (v.audio_series2 ? 1 : 0), 0),
  lessons: chapters.reduce((n, ch) => n + ch.lessons.length, 0),
  typing: 9,
  cards: reviewItems().length,
};
const credit = 'ReanKhmer (រៀនខ្មែរ) @ Seuksa · https://rean.seuksa.com';
const support = 'https://buymeacoffee.com/mtstuffs';
---

<BaseLayout title="វឌ្ឍនភាព Progress">
  <h1 class="mb-6 text-2xl font-semibold"><T km="វឌ្ឍនភាពរបស់ខ្ញុំ" en="My progress" /></h1>

  <aside class="mb-8 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-amber-950 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100" aria-labelledby="share-title">
    <div class="flex gap-4">
      <svg viewBox="0 0 24 24" class="mt-1 size-7 shrink-0 text-amber-600 dark:text-amber-300" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.4-9.3-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.3 6c-2.3 4.6-9.3 9-9.3 9z" /></svg>
      <div class="min-w-0 flex-1">
        <h2 id="share-title" class="text-lg font-semibold"><T km="រៀន និងចែករំលែកដោយសេរី" en="Free to learn and share" /></h2>
        <p class="mt-1 text-sm">
          <T
            km="មាតិកា សំឡេង និងមេរៀនទាំងអស់ក្នុង រៀនខ្មែរ អាចប្រើដើម្បីរៀន បង្រៀន និងចែករំលែកបាន។ សូមដាក់ឈ្មោះ និងតំណភ្ជាប់មកកាន់យើងជានិច្ច។"
            en="Use the content, recordings and lessons to learn, teach and share. Please always credit us and link back."
            stack
          />
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <code id="credit-line" class="rounded-lg bg-white/80 px-3 py-1.5 text-sm break-all text-amber-950 dark:bg-black/30 dark:text-amber-50">{credit}</code>
          <button type="button" id="copy-credit" class="rounded-lg bg-amber-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-700">
            <T km="ចម្លងឈ្មោះ" en="Copy credit" />
          </button>
          <span id="copy-done" class="hidden text-sm" aria-live="polite">✓ <T km="បានចម្លង" en="Copied" /></span>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-amber-300/70 pt-4 dark:border-amber-800/70">
          <a href={support} target="_blank" rel="noopener" class="shrink-0 rounded-xl bg-white p-1.5 shadow-sm" aria-label="Buy Me a Coffee QR code">
            <img src="/support/buymeacoffee-qr.webp" alt="QR code: buymeacoffee.com/mtstuffs" width="112" height="112" loading="lazy" class="size-28" />
          </a>
          <div class="min-w-0 flex-1 basis-56">
            <h3 class="font-semibold"><T km="គាំទ្រ រៀនខ្មែរ" en="Support ReanKhmer" /></h3>
            <p class="mt-1 text-sm">
              <T
                km="រៀនខ្មែរ ឥតគិតថ្លៃ និងគ្មានពាណិជ្ជកម្ម។ បើវាមានប្រយោជន៍សម្រាប់អ្នក ឬគ្រួសាររបស់អ្នក កាហ្វេមួយកែវជួយយើងបន្តថតសំឡេង និងបង្កើតមេរៀនថ្មីៗ។"
                en="ReanKhmer is free and ad-free. If it helps you or your family, a coffee helps us keep recording and building new lessons."
                stack
              />
            </p>
            <a href={support} target="_blank" rel="noopener" class="mt-2 inline-flex items-center gap-2 rounded-lg bg-amber-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-700">
              ☕ <T km="ទិញកាហ្វេឱ្យយើង" en="Buy us a coffee" />
            </a>
            <span class="ml-2 text-xs opacity-75">buymeacoffee.com/mtstuffs</span>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <ProgressPanel client:load totals={totals} packs={packs} />

  <script>
    const btn = document.getElementById('copy-credit');
    btn?.addEventListener('click', async () => {
      const text = document.getElementById('credit-line')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const r = document.createRange();
        r.selectNodeContents(document.getElementById('credit-line')!);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(r);
      }
      const done = document.getElementById('copy-done');
      done?.classList.remove('hidden');
      setTimeout(() => done?.classList.add('hidden'), 2000);
    });
  </script>
</BaseLayout>
