---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import ReviewSession from '../components/ReviewSession.vue';
import { reviewItems } from '../lib/content';
---

<BaseLayout title="រំលឹក Review" description="A few minutes a day: listen and pick, with spaced review of the Khmer letters and words you missed.">
  <h1 class="mb-2 text-2xl font-semibold"><T km="រំលឹកប្រចាំថ្ងៃ" en="Daily review" /></h1>
  <p class="mb-6 max-w-3xl text-slate-600 dark:text-slate-400">
    <T
      km="ស្តាប់ ហើយជ្រើសរើសព្យញ្ជនៈ ស្រៈ លេខ ឬពាក្យដែលអ្នកឮ។ កម្មវិធីនឹងសួរម្តងទៀតនៅពេលដែលអ្នកជិតភ្លេច — ពីរបីនាទីក្នុងមួយថ្ងៃគឺគ្រប់គ្រាន់។"
      en="Hear a letter, vowel sound, number or word and pick it. Each card comes back just before you are likely to forget it (FSRS spaced repetition), so a few minutes a day is enough."
      stack
    />
  </p>
  <ReviewSession client:load items={reviewItems()} />
</BaseLayout>
