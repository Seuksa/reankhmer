---
import BaseLayout from '../../layouts/BaseLayout.astro';
import T from '../../components/T.astro';
import AudioButton from '../../components/AudioButton.vue';
import {
  chapters, consonants, consonantSlug, khmerDigits, letterHref, lessonHref, lessonLetters, lessonTitle, wordsStartingWith,
  type Consonant,
} from '../../lib/content';

export function getStaticPaths() {
  return consonants.map((c, i) => ({
    params: { slug: consonantSlug(c) },
    props: { c, prev: consonants[i - 1], next: consonants[i + 1] },
  }));
}

interface Props { c: Consonant; prev?: Consonant; next?: Consonant }
const { c, prev, next } = Astro.props;
const words = wordsStartingWith(c);
const lesson = chapters.find((ch) => ch.number === 1)?.lessons.find((l) => lessonLetters(l).some((x) => x.id === c.id));
const pos = consonants.indexOf(c) + 1;
const series = c.series === 1
  ? { km: 'អក្សរសំឡេង «អ»', en: 'a-series (first series)', noteKm: 'ឈ្មោះអក្សរនេះបញ្ចប់ដោយសំឡេង «អ»។ ស្រៈដែលនៅជាមួយវា អានតាមសំឡេងទីមួយ (ដូច ក)។', noteEn: 'Its name ends in -or. Vowels after it take their first sound, as with ក.' }
  : { km: 'អក្សរសំឡេង «អូ»', en: 'o-series (second series)', noteKm: 'ឈ្មោះអក្សរនេះបញ្ចប់ដោយសំឡេង «អូ»។ ស្រៈដែលនៅជាមួយវា អានតាមសំឡេងទីពីរ (ដូច គ)។', noteEn: 'Its name ends in -ou. Vowels after it take their second sound, as with គ.' };
const tone = c.series === 1
  ? 'border-teal-300 bg-teal-50 text-teal-900 dark:border-teal-800 dark:bg-teal-950/50 dark:text-teal-100'
  : 'border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100';
const alsoSpelt = c.roman.toLowerCase() !== c.name.toLowerCase() ? c.roman : null;
const description =
  `How to say and write the Khmer consonant ${c.char} (${c.name}): its sound, ${c.series === 1 ? 'a-series' : 'o-series'}` +
  (words.length ? `, example words like ${words.slice(0, 2).map((w) => w.km).join(', ')}` : '') +
  ` and the stroke-order animation. ព្យញ្ជនៈ ${c.char}។`;
---

<BaseLayout title={`ព្យញ្ជនៈ ${c.char} (${c.name}) – Khmer letter`} description={description}>
  <nav class="mb-4 text-sm text-slate-500" aria-label="Breadcrumb">
    <a href="/letters" class="hover:underline"><T km="ព្យញ្ជនៈ" en="Consonants" /></a>
    <span aria-hidden="true"> / </span>
    <span lang="km">{c.char}</span> {c.name}
  </nav>

  <div class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-center">
    <div class:list={['grid size-40 shrink-0 place-items-center self-center rounded-3xl border-2 sm:size-48 sm:self-auto', tone]}>
      <span lang="km" class="font-khmer-serif text-8xl leading-none sm:text-9xl">{c.char}</span>
    </div>
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold sm:text-3xl">
        <T km={`ព្យញ្ជនៈ ${c.char}`} en={`The letter ${c.char}`} />
        <span class="font-normal text-slate-500"> · {c.name}</span>
      </h1>
      {alsoSpelt && <p class="text-sm text-slate-500"><T km="សរសេរជាអក្សរឡាតាំងផងដែរ៖" en="Also romanised as" /> {alsoSpelt}</p>}
      <p class="mt-1 text-sm text-slate-500">
        <T km={`អក្សរទី ${khmerDigits(pos)} ក្នុងចំណោម ៣៣`} en={`Letter ${pos} of 33`} />
      </p>
      <p class="mt-3">
        <span class:list={['inline-block rounded-full border px-3 py-0.5 text-sm font-medium', tone]}><T km={series.km} en={series.en} /></span>
      </p>
      <p class="mt-2 max-w-xl text-slate-600 dark:text-slate-400"><T km={series.noteKm} en={series.noteEn} stack /></p>
      <div class="mt-4 flex flex-wrap gap-3">
        {c.audio && (
          <AudioButton client:visible src={`/${c.audio}`} heardKey={`c:${c.id}`} size="lg">
            <T km={`ស្តាប់ ${c.char}`} en="Listen" />
          </AudioButton>
        )}
        {c.legacy_swf && (
          <a href={`/writing?letter=${consonantSlug(c)}`} class="btn-quiet">
            <T km="មើលរបៀបសរសេរ" en="See how to write it" /> →
          </a>
        )}
      </div>
    </div>
  </div>

  {words.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 text-lg font-semibold"><T km={`ពាក្យដែលចាប់ផ្តើមដោយ ${c.char}`} en={`Words that begin with ${c.char}`} /></h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {words.map((w) => (
          <li class="card flex items-center gap-3">
            <AudioButton client:visible src={w.audio} size="sm" />
            <span class="min-w-0">
              <span lang="km" class="font-khmer-serif block text-2xl">{w.km}</span>
              <span class="block text-sm text-slate-500">{[w.roman, w.en].filter(Boolean).join(' · ')}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="mb-8 flex flex-wrap gap-3">
    {lesson && (
      <a href={lessonHref(1, lesson.number)} class="btn-quiet">
        <T km={`មេរៀន ${lessonTitle(1, lesson).km}`} en={`Lesson: ${lessonTitle(1, lesson).en}`} /> →
      </a>
    )}
    <a href="/letters" class="btn-quiet"><T km="ព្យញ្ជនៈទាំង ៣៣" en="All 33 consonants" /></a>
    <a href="/letters/chart" class="btn-quiet"><T km="តារាងអក្សរសម្រាប់បោះពុម្ព" en="Printable chart" /></a>
  </div>

  <nav class="grid grid-cols-2 gap-3 border-t border-slate-200 pt-6 dark:border-slate-800" aria-label="Letter navigation">
    {prev ? (
      <a href={letterHref(prev)} rel="prev" class="card hover:border-brand-500">
        <span class="text-sm text-slate-500">← <T km="មុន" en="Previous" /></span>
        <span class="block"><span lang="km" class="font-khmer-serif text-2xl">{prev.char}</span> {prev.name}</span>
      </a>
    ) : <span />}
    {next && (
      <a href={letterHref(next)} rel="next" class="card text-right hover:border-brand-500">
        <span class="text-sm text-slate-500"><T km="បន្ទាប់" en="Next" /> →</span>
        <span class="block"><span lang="km" class="font-khmer-serif text-2xl">{next.char}</span> {next.name}</span>
      </a>
    )}
  </nav>
</BaseLayout>
