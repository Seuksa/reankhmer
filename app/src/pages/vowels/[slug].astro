---
import BaseLayout from '../../layouts/BaseLayout.astro';
import T from '../../components/T.astro';
import AudioButton from '../../components/AudioButton.vue';
import { khmerDigits, onCircle, vowelHref, vowels, vowelSlug, wordsWithVowel, type Vowel } from '../../lib/content';

export function getStaticPaths() {
  return vowels.map((v, i) => ({
    params: { slug: vowelSlug(v) },
    props: { v, prev: vowels[i - 1], next: vowels[i + 1] },
  }));
}

interface Props { v: Vowel; prev?: Vowel; next?: Vowel }
const { v, prev, next } = Astro.props;
const words = wordsWithVowel(v);
const roman = v.roman_hint?.toLowerCase();
// Vowels are named on អ (ស្រៈ អា); the inherent vowel has no sign of its own.
const name = (x: Vowel) => (x.sign ? { km: `ស្រៈ ${x.with_series1 ?? onCircle(x.sign)}`, en: `vowel ${onCircle(x.sign)}` } : { km: 'គ្មានស្រៈ', en: 'no vowel sign' });
const me = name(v);
const pos = vowels.indexOf(v) + 1;
const sounds = [
  { s: 1 as const, char: 'ក' + v.sign, audio: v.audio_series1, km: 'ជាមួយអក្សរសំឡេង «អ» (ក)', en: 'With an a-series letter (ក)', tone: 'border-teal-300 bg-teal-50 text-teal-900 dark:border-teal-800 dark:bg-teal-950/50 dark:text-teal-100' },
  { s: 2 as const, char: 'គ' + v.sign, audio: v.audio_series2, km: 'ជាមួយអក្សរសំឡេង «អូ» (គ)', en: 'With an o-series letter (គ)', tone: 'border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100' },
];
const title = v.sign
  ? `${me.km} ${onCircle(v.sign)}${roman ? ` (${roman})` : ''} – Khmer vowel`
  : `គ្មានស្រៈ – Khmer inherent vowel${roman ? ` (${roman})` : ''}`;
const description = v.sign
  ? `The Khmer vowel ${onCircle(v.sign)}${roman ? ` (${roman})` : ''}: hear both of its sounds, with ក and with គ` +
    (words.length ? `, and example words like ${words.slice(0, 2).map((w) => w.km).join(', ')}` : '') + `. ${me.km}។`
  : `The Khmer inherent vowel: how a consonant with no vowel sign is read, with ក and with គ${words.length ? `, and example words like ${words.slice(0, 2).map((w) => w.km).join(', ')}` : ''}.`;
---

<BaseLayout title={title} description={description}>
  <nav class="mb-4 text-sm text-slate-500" aria-label="Breadcrumb">
    <a href="/vowels" class="hover:underline"><T km="ស្រៈ" en="Vowels" /></a>
    <span aria-hidden="true"> / </span>
    <span lang="km">{onCircle(v.sign)}</span> {roman}
  </nav>

  <div class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-center">
    <div class="grid size-40 shrink-0 place-items-center self-center rounded-3xl border-2 border-slate-200 bg-slate-50 sm:size-48 sm:self-auto dark:border-slate-800 dark:bg-slate-900">
      <span lang="km" class="font-khmer-serif text-8xl leading-none text-slate-600 sm:text-9xl dark:text-slate-300">{onCircle(v.sign)}</span>
    </div>
    <div class="min-w-0">
      <h1 class="text-2xl font-semibold sm:text-3xl">
        <T km={me.km} en={v.sign ? `The ${me.en}` : 'The inherent vowel'} />
        {roman && <span class="font-normal text-slate-500"> · {roman}</span>}
      </h1>
      <p class="mt-1 text-sm text-slate-500"><T km={`ស្រៈទី ${khmerDigits(pos)} ក្នុងតារាង`} en={`Vowel ${pos} of ${vowels.length} in the table`} /></p>
      <p class="mt-3 max-w-xl text-slate-600 dark:text-slate-400">
        {v.sign ? (
          <T
            km="ស្រៈនេះមានសំឡេងពីរ៖ មួយពេលនៅជាមួយអក្សរសំឡេង «អ» និងមួយទៀតពេលនៅជាមួយអក្សរសំឡេង «អូ»។ ស្តាប់ទាំងពីរ។"
            en={`This vowel has two sounds: one after an a-series letter and one after an o-series letter. Listen to both.${roman ? ` The romanisation "${roman}" is its first sound.` : ''}`}
            stack
          />
        ) : (
          <T
            km="ពេលព្យញ្ជនៈគ្មានស្រៈ វាអានតាមសំឡេងរបស់ខ្លួន៖ «អ» សម្រាប់អក្សរសំឡេង «អ» និង «អូ» សម្រាប់អក្សរសំឡេង «អូ»។"
            en="A consonant with no vowel sign is read with its own vowel: -or after an a-series letter and -ou after an o-series letter."
            stack
          />
        )}
      </p>
    </div>
  </div>

  <section class="mb-8 grid gap-3 sm:grid-cols-2">
    {sounds.map((x) => (
      <div class="card flex items-center gap-4">
        <span lang="km" class:list={['font-khmer-serif grid size-20 shrink-0 place-items-center rounded-2xl border-2 text-4xl', x.tone]}>{x.char}</span>
        <span class="min-w-0 flex-1">
          <span class="block text-sm text-slate-500"><T km={x.km} en={x.en} stack /></span>
          {x.audio && (
            <span class="mt-2 inline-block">
              <AudioButton client:visible src={`/${x.audio}`} heardKey={`v:${v.id}:${x.s}`}><T km="ស្តាប់" en="Listen" /></AudioButton>
            </span>
          )}
        </span>
      </div>
    ))}
  </section>

  {words.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 text-lg font-semibold">
        {v.sign ? <T km={`ពាក្យដែលមាន ${onCircle(v.sign)}`} en={`Words with ${onCircle(v.sign)}`} /> : <T km="ពាក្យដែលគ្មានស្រៈ" en="Words with no vowel sign" />}
      </h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {words.map((w) => (
          <li class="card flex items-center gap-3">
            <AudioButton client:visible src={w.audio} size="sm" />
            <span class="min-w-0">
              <span lang="km" class="font-khmer-serif block text-2xl">{w.km}</span>
              <span class="block text-sm text-slate-500">{[w.roman, w.en].filter(Boolean).join(' · ')}</span>
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-2 text-xs text-slate-500">
        <T km="ចំណាំ៖ ព្យញ្ជនៈខាងចុង និងសញ្ញាបន្តក់ (់) អាចធ្វើឲ្យសំឡេងស្រៈខ្លី ឬប្រែបន្តិច។" en="Note: a final consonant or the bantâk mark (់) can shorten or change the vowel sound a little." />
      </p>
    </section>
  )}

  <div class="mb-8 flex flex-wrap gap-3">
    <a href="/syllables" class="btn-quiet"><T km="ផ្សំព្យាង្គ" en="Build syllables" /> →</a>
    <a href="/vowels" class="btn-quiet"><T km="ស្រៈទាំងអស់" en="All vowels" /></a>
  </div>

  <nav class="grid grid-cols-2 gap-3 border-t border-slate-200 pt-6 dark:border-slate-800" aria-label="Vowel navigation">
    {prev ? (
      <a href={vowelHref(prev)} rel="prev" class="card hover:border-brand-500">
        <span class="text-sm text-slate-500">← <T km="មុន" en="Previous" /></span>
        <span class="block"><span lang="km" class="font-khmer-serif text-2xl">{onCircle(prev.sign)}</span> {prev.roman_hint?.toLowerCase()}</span>
      </a>
    ) : <span />}
    {next && (
      <a href={vowelHref(next)} rel="next" class="card text-right hover:border-brand-500">
        <span class="text-sm text-slate-500"><T km="បន្ទាប់" en="Next" /> →</span>
        <span class="block"><span lang="km" class="font-khmer-serif text-2xl">{onCircle(next.sign)}</span> {next.roman_hint?.toLowerCase()}</span>
      </a>
    )}
  </nav>
</BaseLayout>
