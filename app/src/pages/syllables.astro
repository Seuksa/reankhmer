---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import SyllableBuilder from '../components/SyllableBuilder.vue';
import { consonants, vowels } from '../lib/content';
---

<BaseLayout title="ផ្សំព្យាង្គ Syllables" description="Build Khmer syllables from a consonant, a vowel and a subscript, and hear how they sound. ផ្សំព្យាង្គខ្មែរ។">
  <h1 class="mb-2 text-2xl font-semibold"><T km="ផ្សំព្យាង្គ" en="Build a syllable" /></h1>
  <p class="mb-6 max-w-3xl text-slate-600 dark:text-slate-400">
    <T
      km="ជ្រើសព្យញ្ជនៈ ស្រៈ និងជើងអក្សរ ដើម្បីមើលថាវាផ្សំគ្នាយ៉ាងដូចម្តេច។ ចុចលើផ្នែកនីមួយៗដើម្បីស្តាប់ ឬចុច «ប្រកប» ដើម្បីស្តាប់តាមលំដាប់។"
      en="Pick a consonant, a vowel and an optional subscript to see how they combine. Tap each part to hear it, or press “Spell it” to hear them in order."
      stack
    />
  </p>
  <SyllableBuilder client:load consonants={consonants} vowels={vowels} />
</BaseLayout>
