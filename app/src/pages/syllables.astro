---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import SyllableBuilder from '../components/SyllableBuilder.vue';
import { consonants, vowels } from '../lib/content';
---

<BaseLayout title="ផ្សំព្យាង្គ Syllables">
  <h1 class="mb-2 text-2xl font-semibold"><T km="ផ្សំព្យាង្គ" en="Build a syllable" /></h1>
  <p class="mb-6 max-w-3xl text-slate-600 dark:text-slate-400">
    <T
      km="ជ្រើសព្យញ្ជនៈ ស្រៈ និងជើងអក្សរ ដើម្បីមើលថាវាសរសេររួមគ្នាយ៉ាងដូចម្តេច ហើយស្តាប់ថាក្រុមព្យញ្ជនៈផ្លាស់ប្តូរសំឡេងស្រៈយ៉ាងណា។"
      en="Pick a consonant, a vowel and an optional subscript to see how they combine on the page, and hear how the consonant's series changes the vowel."
      stack
    />
  </p>
  <SyllableBuilder client:load consonants={consonants} vowels={vowels} />
</BaseLayout>
