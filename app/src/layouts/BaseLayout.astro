---
import '../styles/global.css';
import { pwaInfo } from 'virtual:pwa-info';
import T from '../components/T.astro';
import Toggles from '../components/Toggles.vue';

interface Props { title?: string; description?: string }
const { title, description = 'Learn to read, hear and speak Khmer — រៀនអាន ស្តាប់ និងនិយាយភាសាខ្មែរ' } = Astro.props;
const fullTitle = title ? `${title} · រៀនខ្មែរ ReanKhmer` : 'រៀនខ្មែរ ReanKhmer – Learn Khmer';
const path = Astro.url.pathname.replace(/\.html$/, '');

const nav = [
  { href: '/letters', km: 'ព្យញ្ជនៈ', en: 'Letters', icon: 'M5 19V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v13M5 19h14M9 9h6M9 13h4' },
  { href: '/vowels', km: 'ស្រៈ', en: 'Vowels', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8 12h8M12 8v8' },
  { href: '/numbers', km: 'លេខ', en: 'Numbers', icon: 'M4 9h16M4 15h16M10 3 8 21M16 3l-2 18' },
  { href: '/keyboard', km: 'វាយអក្សរ', en: 'Typing', icon: 'M3 6h18v12H3zM7 10h.01M11 10h.01M15 10h.01M7 14h10' },
  { href: '/lessons', km: 'មេរៀន', en: 'Lessons', icon: 'M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2zM8 7h6' },
  { href: '/progress', km: 'វឌ្ឍនភាព', en: 'Progress', icon: 'M4 20V10M10 20V4M16 20v-7M22 20H2' },
];
const active = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="km" data-lang="both">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google" content="notranslate" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path || '/', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f766e" />
    <meta property="og:title" content={title ?? 'រៀនខ្មែរ ReanKhmer'} />
    <meta property="og:description" content={description} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script is:inline>
      try {
        const d = document.documentElement;
        const l = localStorage.getItem('lang');
        if (l === 'km' || l === 'en' || l === 'both') d.dataset.lang = l;
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) d.classList.add('dark');
      } catch {}
    </script>
    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </head>
  <body class="flex min-h-dvh flex-col pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-brand-700 focus:px-3 focus:py-2 focus:text-white">Skip to content</a>
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
      <div class="mx-auto flex h-14 max-w-5xl items-center gap-4 px-4">
        <a href="/" class="flex items-center gap-2 font-semibold">
          <img src="/favicon.svg" alt="" class="size-8" />
          <span><span lang="km" class="text-lg">រៀនខ្មែរ</span> <span class="text-sm text-slate-500">ReanKhmer</span></span>
        </a>
        <nav class="ml-auto hidden gap-1 md:flex" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}
              class:list={['rounded-lg px-3 py-1.5 text-sm hover:bg-slate-100 dark:hover:bg-slate-800', active(n.href) && 'bg-brand-50 text-brand-800 dark:bg-brand-900/40 dark:text-brand-100']}>
              <T km={n.km} en={n.en} />
            </a>
          ))}
        </nav>
        <div class="ml-auto md:ml-2"><Toggles client:load /></div>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
      <slot />
    </main>

    <footer class="border-t border-slate-200 py-6 text-center text-sm text-slate-500 dark:border-slate-800">
      <p>
        ReanKhmer · Sok Pongsametrey —
        <T km="មាតិកា ការដឹកនាំគម្រោង និងការគ្រប់គ្រង" en="content, project lead and management" />
      </p>
      <p class="mt-1">
        <T km="ថតសំឡេងនៅស្ទូឌីយោ CSC Cambodia ជាមួយសហការី ឆ្នាំ ២០០៦" en="Audio recorded at the CSC Cambodia studio with colleagues, 2006" />
      </p>
      <p class="mt-1">
        <T km="អភិវឌ្ឍវេទិកា និង Flash៖" en="Platform and Flash development:" /> Sok Pongsametrey, Sok Leaksmy, Ouk Sidavy · RUPP Science Fair 2006
      </p>
      <p class="mt-1"><a class="underline hover:text-brand-700" href="https://seuksa.com">seuksa.com</a> · <a class="underline hover:text-brand-700" href="https://github.com/metrey/LearningKhmer">GitHub</a></p>
    </footer>

    <nav class="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden dark:border-slate-800 dark:bg-slate-950/95" aria-label="Main">
      <ul class="grid grid-cols-6">
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}
              class:list={['flex h-16 flex-col items-center justify-center gap-0.5 text-xs', active(n.href) ? 'text-brand-700 dark:text-brand-200' : 'text-slate-500']}>
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={n.icon} /></svg>
              <span lang="km" class="t-km leading-tight">{n.km}</span>
              <span lang="en" class="t-en leading-tight !m-0 !text-[0.65rem]">{n.en}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </body>
</html>
